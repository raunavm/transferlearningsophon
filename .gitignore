*.pt
*.pth
*.ckpt
*.h5
*.joblib
*.pkl

# Notebooks (this repo ships scripts only)
*.ipynb

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs and run artifacts
*.log
lightning_logs/
wandb/
runs/

# Claude Code and AI workflow artifacts
.claude/

# ALL markdown is local-only — never commit/push any .md (per PI, 2026-07-17).
# Every doc (PLAN.md, AGENT.md, CHANGELOG.md, all READMEs, reports, grouping
# notes) stays on disk but is never tracked. Already-committed ones must be
# untracked once with `git rm --cached <file>` (they remain on disk).
*.md

# Research vault — local-only, and LARGE. research/raw/ alone is ~335 MB of
# fetched PDFs and .hyperresearch/hyperresearch.db is ~41 MB. The notes are
# .md and already covered above; these rules catch the rest.
#
# This is not only repo hygiene: every training pod CLONES this repo, so
# anything tracked here is re-downloaded on every launch, for every arm.
research/
.hyperresearch/

# TREE_REVIEW.txt is a review document that happens not to end in .md.
docs/
